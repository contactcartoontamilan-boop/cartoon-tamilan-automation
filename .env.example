# Never commit real tokens. Configure these as GitHub Actions Secrets/Variables
# or environment variables on your Oracle server.

DRY_RUN=true
PUBLISH_FACEBOOK=false
PUBLISH_INSTAGRAM=false

META_GRAPH_VERSION=v26.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# V9 campaign settings: PREVIEW is always safe unless --publish is used.
ART_PROVIDER=cover
ART_STYLE=anime
AUTO_PUBLISH_APPROVED=false

# Must be an existing, publicly HTTPS-served image directory (for Meta to fetch)
PUBLIC_MEDIA_DIR=
PUBLIC_MEDIA_BASE_URL=

# Optional self-hosted AI generation. Requires model weights and adequate compute.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/story_txt2img_api.json
COMFYUI_CHECKPOINT=
COMFYUI_PROMPT_NODE=6
COMFYUI_CHECKPOINT_NODE=4
COMFYUI_SAMPLER_NODE=3
COMFYUI_SEED=20261112

# V10 premium campaign; keep preview enabled until setup and review complete
USE_SITE_SYNOPSIS=true
ART_MODE=cover
DAILY_STORY_LIMIT=1
CAMPAIGN_V10_PUBLISH=false
# Set true only after BOTH V9 and V10 approvals, Meta credentials and HTTPS image hosting

# V12: always default to no live publishing.
V12_MODE=preview
V12_ALERTS_ENABLED=false
V12_TELEGRAM_BOT_TOKEN=
V12_TELEGRAM_CHAT_ID=
# Optional local-only chapter/editor assistant; requires installed Ollama model.
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=

# V12 Google Analytics / Search Console (only when authorized by property owner).
# Keep OAuth refresh secrets on Oracle ONLY; never commit them.
GA4_PROPERTY_ID=
GSC_PROPERTY=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PAGESPEED_API_KEY=

# Multi-provider text AI router (ct_ai_router.py); never commit real API keys.
AI_PROVIDER=ollama
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_REQUEST_LIMIT=20
AI_USAGE_DB=data/ai_usage.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Image/video/voice adapter defaults. External calls are disabled until explicitly enabled.
ENABLE_AI_MEDIA_API=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_TTS_VOICE=eve

# Optional per-hour media creation for owned CartoonTamilan story queue.
CT_V14_HOURLY_MEDIA_ENABLED=false
CT_V14_QUEUE_IMAGE_PROVIDER=gemini
CT_V14_QUEUE_VIDEO_PROVIDER=xai
CT_V14_QUEUE_VOICE_PROVIDER=azure
CT_V14_QUEUE_VIDEO_SECONDS=8
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Free local CPU mode: FFmpeg makes a scene-based motion-comic from owned chapter text.
# Enable local narration with the installed Indic Tiny Tamil female voice model.
# This is still artwork motion, not generated character animation.
CT_V14_LOCAL_VIDEO_ENABLED=false
CT_V14_LOCAL_VOICE_ENABLED=true
CT_V14_REEL_VOICE=indic_tiny
CT_V14_REEL_SECONDS=90
CT_TAMIL_VOICE_SPEED=1.3
CT_TAMIL_MODEL_DIR=
# YouTube full episode uploads remain separately opt-in, reviewed and credential-gated.
CT_V14_ENABLE_YOUTUBE_LONG_VIDEO=false
