# Never commit real tokens. Configure these as GitHub Actions Secrets/Variables
# or environment variables on your Oracle server.

DRY_RUN=true
PUBLISH_FACEBOOK=false
PUBLISH_INSTAGRAM=false

META_GRAPH_VERSION=v26.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# V9 campaign settings: PREVIEW is always safe unless --publish is used.
ART_PROVIDER=cover
ART_STYLE=anime
AUTO_PUBLISH_APPROVED=false

# Must be an existing, publicly HTTPS-served image directory (for Meta to fetch)
PUBLIC_MEDIA_DIR=
PUBLIC_MEDIA_BASE_URL=

# Optional self-hosted AI generation. Requires model weights and adequate compute.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/story_txt2img_api.json
COMFYUI_CHECKPOINT=
COMFYUI_PROMPT_NODE=6
COMFYUI_CHECKPOINT_NODE=4
COMFYUI_SAMPLER_NODE=3
COMFYUI_SEED=20261112

# V10 premium campaign; keep preview enabled until setup and review complete
USE_SITE_SYNOPSIS=true
ART_MODE=cover
DAILY_STORY_LIMIT=1
CAMPAIGN_V10_PUBLISH=false
# Set true only after BOTH V9 and V10 approvals, Meta credentials and HTTPS image hosting

# V12: always default to no live publishing.
V12_MODE=preview
V12_ALERTS_ENABLED=false
V12_TELEGRAM_BOT_TOKEN=
V12_TELEGRAM_CHAT_ID=
# Optional local-only chapter/editor assistant; requires installed Ollama model.
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=

# V12 Google Analytics / Search Console (only when authorized by property owner).
# Keep OAuth refresh secrets on Oracle ONLY; never commit them.
GA4_PROPERTY_ID=
GSC_PROPERTY=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PAGESPEED_API_KEY=
